# Copiar a terraform.tfvars (ignorado por git) y completar sin secretos.
project_name = "HerramientasTIC"
image_prefix = "ghcr.io/juanaldairramirezmendez/herramientastic-tic"

# Bootstrap únicamente. En operación normal, fijar digests inmutables:
# image_digests = {
#   backend-api    = "sha256:..."
#   backend-worker = "sha256:..."
#   frontend       = "sha256:..."
# }
image_tag = "latest"

