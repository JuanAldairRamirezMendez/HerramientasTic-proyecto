# ==========================================
# SUPABASE CONFIGURACIÓN
# ==========================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_key
SUPABASE_SECRET_KEY=sb_secret_tu_secret_key
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# ==========================================
# CONFIGURACIÓN DE LA APP
# ==========================================
QUEUE_ENABLED=true
FRONTEND_URL=http://localhost:80

# ==========================================
# IA (GEMINI - GOOGLE AI STUDIO)
# ==========================================
# Clave obligatoria. Obtén una en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo económico para el plan gratuito.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
# Nivel de razonamiento: minimal | low | medium | high
GEMINI_THINKING_LEVEL=minimal
# Tope de tokens para el flujo de cámara.
IA_MOBILE_MAX_TOKENS=768

# ==========================================
# CLOUDFLARE TUNNEL (OPCIONAL PARA DOMINIO PROPIO)
# ==========================================
# Si deseas usar un túnel nombrado persistente con tu propio dominio en Cloudflare Zero Trust:
# 1. Obtén el token en el dashboard de Cloudflare Zero Trust -> Networks -> Tunnels
# 2. Descomenta la siguiente línea y reemplaza el valor
# 3. En docker-compose.yml cambia el command del servicio tunnel a: tunnel --no-autoupdate run --token ${CLOUDFLARE_TUNNEL_TOKEN}
# CLOUDFLARE_TUNNEL_TOKEN=tu_token_aqui
