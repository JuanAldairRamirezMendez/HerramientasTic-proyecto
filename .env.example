# ==========================================
# SUPABASE CONFIGURACIÓN
# ==========================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_key
SUPABASE_SECRET_KEY=sb_secret_tu_secret_key
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# ==========================================
# CONFIGURACIÓN DE LA APP
# ==========================================
QUEUE_ENABLED=true
FRONTEND_URL=http://localhost:80

# ==========================================
# IA: GOOGLE AI STUDIO (GEMINI) + OLLAMA
# ==========================================
# Proveedor principal: gemini | ollama | auto (auto: Gemini si hay clave, si no Ollama)
IA_PROVIDER=auto
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# En el plan gratuito, gemini-3.5-flash-lite es el más económico en tokens.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_THINKING_LEVEL=minimal
# Si Gemini falla, intentar Ollama antes del clasificador local
OLLAMA_FALLBACK=true

# ==========================================
# OLLAMA CONFIGURACIÓN (respaldo local)
# ==========================================
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://192.168.18.10:11434
# Tiempo máximo de espera a Ollama por documento (ms). Default en código: 180000 (3 min)
OLLAMA_TIMEOUT_MS=600000
# Tope de tokens de salida del flujo de escaneo con cámara (Ollama num_predict /
# Gemini maxOutputTokens). Acota el peor caso en hardware sin GPU. Default: 768
IA_MOBILE_MAX_TOKENS=768

# ==========================================
# CLOUDFLARE TUNNEL (OPCIONAL PARA DOMINIO PROPIO)
# ==========================================
# Si deseas usar un túnel nombrado persistente con tu propio dominio en Cloudflare Zero Trust:
# 1. Obtén el token en el dashboard de Cloudflare Zero Trust -> Networks -> Tunnels
# 2. Descomenta la siguiente línea y reemplaza el valor
# 3. En docker-compose.yml cambia el command del servicio tunnel a: tunnel --no-autoupdate run --token ${CLOUDFLARE_TUNNEL_TOKEN}
# CLOUDFLARE_TUNNEL_TOKEN=tu_token_aqui
